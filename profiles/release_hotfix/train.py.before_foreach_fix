@contextmanager
def timed(device="cpu"):
    synchronize(device)
    result = {}
    start = perf_counter()
    yield result
    synchronize(device)
    result["seconds"] = perf_counter() - start


@contextmanager
def _profile_timer(metrics, name, device):
    """Optional phase wall timer; synchronizes at coarse boundaries only."""
    if metrics is None:
        yield
        return
    synchronize(device)
    started = perf_counter()
    try:
        yield
    finally:
        synchronize(device)
        metrics[name] = metrics.get(name, 0.0) + (perf_counter() - started)


def _profile_tick(metrics, name, started):
    """Measure rollout wall time (act_batch itself synchronizes GPU -> CPU)."""
    if metrics is not None:
        metrics[name] = metrics.get(name, 0.0) + (perf_counter() - started)



def _rollout_profiler(model, enabled):
    """Profile only a selected rollout episode; CPU-only smoke tests also work."""
    if not enabled:
        return nullcontext()
    from torch.profiler import ProfilerActivity, profile as torch_profile
    activities = [ProfilerActivity.CPU]
    if model.device.type == 'musa':
        musa_activity = getattr(ProfilerActivity, 'MUSA', None)
        if musa_activity is None:
            raise RuntimeError('This torch_musa build does not expose ProfilerActivity.MUSA')
        activities.append(musa_activity)
    return torch_profile(activities=activities, record_shapes=False,
                         profile_memory=False, with_stack=False)

@contextmanager
def _sealed_rollout_observations(model):
    """Temporarily seal independent observation snapshots during key caching.

    ParallelEnvs.snapshot() and Env._observation() return owned copies; only
    those are sealed. Restore their original writability before PPO preparation
    so training data and tensor conversion behavior remain unchanged.
    """
    sealed = []

    def seal(observation):
        for name in ('pfn_state', 'global_state'):
            value = observation[name]
            if isinstance(value, np.ndarray) and value.flags.owndata and value.flags.writeable:
                value.setflags(write=False)
                sealed.append(value)
    try:
        yield seal
    finally:
        # Exception-safe: normal callers and PPO get writable snapshots back.
        for value in sealed:
            value.setflags(write=True)


def write_json(path, value):
    Path(path).write_text(json.dumps(value, ensure_ascii=False, indent=2), encoding="utf-8")


def prediction_for(bundle, rounds, seed, path=None):
    if path is not None:
        # Archive binds predictions to exact graph, features, and node order.
        with np.load(path) as archive:
            if not np.array_equal(archive["adjacency"], bundle.public.adjacency) or not np.array_equal(
                    archive["features"], bundle.public.features):
                raise ValueError("Prediction archive does not match this task's graph/node order/features.")
            prediction = archive["mu_hat"].copy()
        if prediction.shape != (bundle.public.n, 2, 2):
            raise ValueError("mu_hat axis order must be [node, own treatment, majority exposure].")
        return prediction
    z, s, y = bundle.oracle.randomized_experiment(bundle.public, rounds, seed)
    return fit_factual_prediction(bundle.public, z, s, y)


def episode_seed(root, split, task_index, replicate, episode, stream):
    seed = task_seed(root, split, task_index, stream)
    return int(np.random.SeedSequence([seed, replicate, episode]).generate_state(1)[0])


@dataclass(frozen=True)
class PPOConfig:
    learning_rate: float = 3e-4
    gamma: float = 1.0
    gae_lambda: float = 0.95
    clip: float = 0.2
    value_coef: float = 0.5
    entropy_coef: float = 0.01
    epochs: int = 4
    minibatch: int = 32
    max_grad_norm: float = 0.5


class RolloutBuffer:
    """Preallocated transition columns; histories reference one factual record bank."""

    def __init__(self, capacity, context_length, prefix_capacity=None):
        self.capacity, self.context_length, self.size = capacity, context_length, 0
        self.observations = [None] * capacity
        for name in ('actions', 'episodes', 'times', 'history_lengths', 'treated_counts'):
            setattr(self, name, np.zeros(capacity, dtype=np.int64))
        for name in ('rewards', 'old_log_probs', 'values', 'advantages', 'targets'):
            setattr(self, name, np.zeros(capacity, dtype=np.float64))
        self.done = np.zeros(capacity, dtype=bool)
        self.history_indices = np.zeros((capacity, context_length), dtype=np.int64)
        extra = context_length if prefix_capacity is None else prefix_capacity
        self.records = [None] * (capacity + extra)
        self.record_observations = [None] * (capacity + extra)
        self.record_count, self._record_ids = 0, {}

    def __len__(self):
        return self.size

    def register_record(self, record, obs):
        key = id(record)
        if key not in self._record_ids:
            index = self.record_count
            self.records[index] = record
            self.record_observations[index] = obs
            self._record_ids[key] = index
            self.record_count += 1
        return self._record_ids[key]

    def write(self, row, obs, history_ids, episode, action, log_prob, value, reward, done, record):
        self.observations[row] = obs
        self.actions[row], self.episodes[row], self.times[row] = action, episode, obs['episode_time']
        self.old_log_probs[row], self.values[row], self.rewards[row] = log_prob, value, reward
        self.done[row] = done
        self.treated_counts[row] = obs['catalog'][action].sum()
        length = len(history_ids)
        self.history_lengths[row] = length
        self.history_indices[row, :length] = history_ids
        self.size = max(self.size, row + 1)
        return self.register_record(record, obs)

    def episode_return(self, gamma):
        return float(np.sum(gamma ** self.times[:self.size] * self.rewards[:self.size]))


def finish_episode(buffer, start, stop, gamma, gae_lambda):
    """A complete physical episode ends at stop; its terminal bootstrap is zero."""
    if not buffer.done[stop - 1]:
        raise ValueError('Collector must finish the episode before a PPO update.')
    advantage, next_value = 0.0, 0.0
    for row in range(stop - 1, start - 1, -1):
        continuation = 1.0 - float(buffer.done[row])
        delta = buffer.rewards[row] + gamma * continuation * next_value - buffer.values[row]
        advantage = delta + gamma * gae_lambda * continuation * advantage
        buffer.advantages[row] = advantage
        buffer.targets[row] = advantage + buffer.values[row]
        next_value = buffer.values[row]


def collect_episode(model, env, noise_seed, episode, history, generator, config,
                    deterministic=False, buffer=None):
    obs, _ = env.reset(seed=noise_seed)
    limit = model.config.context_length
    if buffer is None:
        buffer = RolloutBuffer(env.task.horizon, limit)
    start = len(buffer)
    context = list(history[-limit:]) if limit > 0 else []
    context_ids = [buffer.register_record(record, obs) for record in context]
    model.eval()
    with model.cached_inference():
        while obs['tabular_state_key'][0] > 0:
            action, log_prob, value = model.act(obs, context, episode, generator=generator,
                                              deterministic=deterministic)
            next_obs, reward, done, _, _ = env.step(action)
            record = FactualRecord.from_step(obs, action, reward, next_obs, done, episode)
            record_id = buffer.write(len(buffer), obs, context_ids, episode, action,
                                     log_prob, value, reward, done, record)
            if limit > 0:
                context.append(record)
                context_ids.append(record_id)
                context, context_ids = context[-limit:], context_ids[-limit:]
            obs = next_obs
    finish_episode(buffer, start, len(buffer), config.gamma, config.gae_lambda)
    return buffer, context


def collect_tasks(model, tasks, episodes, generator, config, environments=None, profile=None, trace=None):
    """Independent factual timelines, stored in task/episode/time order."""
    mark = perf_counter() if profile is not None else 0.0
    if environments is not None:
        environments.load(tasks)
    _profile_tick(profile, 'rollout_env_load_s', mark)
    horizons = np.array([env.task.horizon for env, _ in tasks], dtype=np.int64)
    offsets = np.r_[0, np.cumsum(horizons * episodes)[:-1]]
    limit = model.config.context_length
    buffer = RolloutBuffer(int(horizons.sum() * episodes), limit, prefix_capacity=0)
    contexts = [[] for _ in tasks]
    context_ids = [[] for _ in tasks]
    model.eval()
    with _sealed_rollout_observations(model) as seal, model.cached_inference():
        for episode in range(episodes):
            mark = perf_counter() if profile is not None else 0.0
            observations = (environments.reset([seeds[episode] for _, seeds in tasks])
                            if environments is not None else
                            [env.reset(seed=seeds[episode])[0] for env, seeds in tasks])
            _profile_tick(profile, 'rollout_env_reset_s', mark)
            for observation in observations:
                seal(observation)
            active = list(range(len(tasks)))
            tracing = trace is not None and episode == trace['episode']
            with _rollout_profiler(model, tracing) as rollout_profiler:
                if tracing:
                    model._rollout_trace_active = True
                try:
                    while active:
                        mark = perf_counter() if profile is not None else 0.0
                        with (torch.profiler.record_function('PFN/Rollout/act_batch')
                              if tracing else nullcontext()):
                            choices = model.act_batch([observations[i] for i in active],
                                                      [contexts[i] for i in active], [episode] * len(active),
                                                      generator, history_slots=active)
                        _profile_tick(profile, 'rollout_policy_act_batch_s', mark)
                        mark = perf_counter() if profile is not None else 0.0
                        with (torch.profiler.record_function('PFN/Rollout/env_step')
                              if tracing else nullcontext()):
                            transitions = (environments.step([(i, int(choice[0])) for i, choice in zip(active, choices)])
                                           if environments is not None else
                                           {i: tasks[i][0].step(int(choice[0])) for i, choice in zip(active, choices)})
                        _profile_tick(profile, 'rollout_env_step_s', mark)
                        mark = perf_counter() if profile is not None else 0.0
                        remaining = []
                        for i, (action, log_prob, value) in zip(active, choices):
                            action = int(action)
                            obs = observations[i]
                            next_obs, reward, done, _, _ = transitions[i]
                            seal(next_obs)
                            record = FactualRecord.from_step(obs, action, reward, next_obs, done, episode)
                            row = int(offsets[i] + episode * horizons[i] + obs['episode_time'])
                            record_id = buffer.write(row, obs, context_ids[i], episode, action,
                                                     log_prob, value, reward, done, record)
                            if limit > 0:
                                contexts[i].append(record)
                                context_ids[i].append(record_id)
                                contexts[i], context_ids[i] = contexts[i][-limit:], context_ids[i][-limit:]
                            observations[i] = next_obs
                            if not done:
                                remaining.append(i)
                        active = remaining
                        _profile_tick(profile, 'rollout_bookkeeping_s', mark)
                finally:
                    if tracing:
                        model._rollout_trace_active = False
            if tracing:
                path = Path(trace['dir'])
                path.mkdir(parents=True, exist_ok=True)
                path = path / (f"rollout_update{trace['update']:04d}_rank{trace['rank']}"
                               f"_episode{episode:03d}.pt.trace.json")
                rollout_profiler.export_chrome_trace(str(path))
                print(f"ROLLOUT_TRACE {path}", flush=True)
            mark = perf_counter() if profile is not None else 0.0
            for i, horizon in enumerate(horizons):
                start = int(offsets[i] + episode * horizon)
                finish_episode(buffer, start, start + int(horizon), config.gamma, config.gae_lambda)
            _profile_tick(profile, 'rollout_finish_episode_s', mark)
    return buffer


class PPOTrainer:
    def __init__(self, model, config: PPOConfig, seed=0):
        self.model, self.config = model, config
        self.parallel = distributed.wrap_policy(model)
        self.optimizer = torch.optim.Adam(model.parameters(), lr=config.learning_rate,
                                          fused=False, foreach=True)
        rank_seed = seed if distributed.world_size() == 1 else int(
            np.random.SeedSequence([seed, distributed.rank()]).generate_state(1)[0])
        self.rng = np.random.default_rng(rank_seed)
        self.action_generator = action_generator().manual_seed(rank_seed)
        self.real_interactions, self.gradient_steps = 0, 0

    def update(self, rollout, profile=None, update_index=None):
        cfg, model = self.config, self.model
        model.eval()  # Attention dropout is disabled; gradients remain enabled.
        count = len(rollout)
        observations = rollout.observations[:count]
        advantages = rollout.advantages[:count]
        with _profile_timer(profile, 'ppo_normalize_advantages_s', model.device):
            advantages = distributed.normalize_advantages(advantages, model.device)
        size = distributed.world_size()
        if cfg.minibatch < size or cfg.minibatch % size:
            raise ValueError('Global minibatch must be divisible by world size')
        with _profile_timer(profile, 'ppo_ddp_precheck_s', model.device):
            if distributed.active():
                counts = distributed.gather_json(count, model.device)
                if count == 0 or len(set(counts)) != 1:
                    raise ValueError('DDP requires equal nonempty rollout sizes on all ranks')
        with _profile_timer(profile, 'ppo_mask_build_s', model.device):
            max_m = max(len(obs['catalog']) for obs in observations)
            full_masks = np.zeros((count, max_m), dtype=bool)
            by_catalog = {}
            for row, obs in enumerate(observations):
                catalog, budget = obs['catalog'], obs['task_budget']
                key = (id(catalog), budget)
                if key not in by_catalog:
                    by_catalog[key] = catalog.sum(1) == budget
                full_masks[row, :len(catalog)] = by_catalog[key]
            full_masks = torch.tensor(full_masks, device=model.device)
        with _profile_timer(profile, 'ppo_prepare_rollout_s', model.device):
            prepared = model.prepare_rollout(rollout)
        with _profile_timer(profile, 'ppo_tensor_upload_s', model.device):
            actions_all = torch.tensor(rollout.actions[:count], device=model.device)
            old_log_probs = model._tensor(rollout.old_log_probs[:count])
            targets_all = model._tensor(rollout.targets[:count])
            advantages_all = model._tensor(advantages)
            weights_all = model._tensor(cfg.gamma ** rollout.times[:count])
        with _profile_timer(profile, 'ppo_prepare_minibatches_s', model.device):
            orders = [self.rng.permutation(len(rollout)) for _ in range(cfg.epochs)]
            plans = model.prepare_minibatches(prepared, orders, cfg.minibatch // size)
        # Preserve the optimized implementation's gradient behavior. The
        # original rollout-wide history head has optimizer-momentum semantics
        # that need to survive history-length cropping.
        with _profile_timer(profile, 'ppo_history_sync_s', model.device):
            history_graph_active = prepared['length'] > 0
            if self.parallel is not None:
                history_graph_active = distributed.max_value(prepared['length'], model.device) > 0

        # An optional short PyTorch/MUSA timeline is collected only on selected
        # ranks and update indices. Phase timers can run independently.
        trace_path = os.environ.get('PFN_TORCH_TRACE_DIR')
        trace_update = int(os.environ.get('PFN_TORCH_TRACE_UPDATE', '1'))
        trace_ranks = os.environ.get('PFN_TORCH_TRACE_RANKS', '0')
        trace_this_rank = trace_ranks == 'all' or str(distributed.rank()) in trace_ranks.split(',')
        trace_enabled = (bool(trace_path) and update_index is not None and
                         update_index + 1 == trace_update and trace_this_rank)
        trace_context = nullcontext()
        if trace_enabled:
            import torch_musa  # Install torch_musa alongside torch on the server.
            from torch.profiler import (ProfilerActivity, profile as torch_profile,
                                        schedule as trace_schedule, tensorboard_trace_handler)
            musa_activity = getattr(ProfilerActivity, 'MUSA', None)
            if musa_activity is None:
                raise RuntimeError('This torch_musa build has no ProfilerActivity.MUSA')
            Path(trace_path).mkdir(parents=True, exist_ok=True)
            trace_context = torch_profile(
                activities=[ProfilerActivity.CPU, musa_activity],
                schedule=trace_schedule(wait=1, warmup=1, active=3, repeat=1),
                on_trace_ready=tensorboard_trace_handler(
                    trace_path, worker_name=f'rank{distributed.rank()}_update{update_index + 1}'),
                record_shapes=False, profile_memory=False, with_stack=False)

        metrics = []
        traced_steps = 0
        with trace_context as trace:
            with _profile_timer(profile, 'ppo_minibatch_loop_s', model.device):
                for epoch in plans:
                    for plan in epoch:
                        ids = plan['ids']
                        self.optimizer.zero_grad(set_to_none=True)
                        with (torch.profiler.record_function('PFN/forward_and_loss')
                              if trace is not None and traced_steps < 5 else nullcontext()):
                            if self.parallel is None:
                                dist, values = model.forward_prepared(prepared, plan)
                            else:
                                logits, values = self.parallel(prepared, plan)
                                dist = torch.distributions.Categorical(logits=logits, validate_args=False)
                            actions, old_log_prob = actions_all[ids], old_log_probs[ids]
                            targets, adv, weights = targets_all[ids], advantages_all[ids], weights_all[ids]
                            log_prob = dist.log_prob(actions)
                            ratio = torch.exp(log_prob - old_log_prob)
                            policy_loss = -torch.minimum(ratio * adv, ratio.clamp(1 - cfg.clip, 1 + cfg.clip) * adv)
                            value_loss = (values - targets).square()
                            entropy = dist.entropy()
                            loss = (weights * (policy_loss + cfg.value_coef * value_loss
                                               - cfg.entropy_coef * entropy)).mean()
                        with (torch.profiler.record_function('PFN/backward_and_DDP')
                              if trace is not None and traced_steps < 5 else nullcontext()):
                            loss.backward()
                            # Preserve the optimized implementation's gradient handling.
                            for parameter in model.record_token.parameters():
                                if not history_graph_active:
                                    parameter.grad = None
                                elif parameter.requires_grad and parameter.grad is None:
                                    parameter.grad = torch.zeros_like(parameter)
                            if not model.config.joint_head:
                                for parameter in model.action_head.parameters():
                                    parameter.grad = None
                        with (torch.profiler.record_function('PFN/optimizer')
                              if trace is not None and traced_steps < 5 else nullcontext()):
                            torch.nn.utils.clip_grad_norm_(model.parameters(), cfg.max_grad_norm,
                                                           foreach=True)
                            self.optimizer.step()
                        self.gradient_steps += 1
                        full = full_masks[ids]
                        # Aggregate on the GPU. No per-sample scalar copies or synchronizations.
                        metrics.append(torch.stack((loss.detach(), (old_log_prob - log_prob).detach().mean(),
                                                     entropy.detach().mean(),
                                                     ((ratio.detach() - 1).abs() > cfg.clip).float().mean(),
                                                     (dist.probs.detach() * full).sum(1).mean())))
                        if trace is not None and traced_steps < 5:
                            trace.step()
                            traced_steps += 1
        with _profile_timer(profile, 'ppo_metrics_s', model.device):
            self.real_interactions += len(rollout) * size
            names = ('loss', 'approx_kl', 'entropy', 'clip_fraction', 'full_budget_probability')
            averages = distributed.sum_values(torch.stack(metrics).mean(0), model.device) / size
            result = dict(zip(names, averages.cpu().tolist()))
            result['max_history_records'] = int(distributed.max_value(rollout.history_lengths[:count].max(), model.device))
            for dynamics, index in (('FC', 1), ('CD', 2)):
                selected = np.array([bool(obs['global_state'][index]) for obs in observations])
                total, number = distributed.sum_values(
                    [float(rollout.treated_counts[:count][selected].sum()), int(selected.sum())], model.device).cpu().tolist()
                if number:
                    result[f'treated_count_{dynamics}'] = total / number
        return result

    def checkpoint(self, path, driver):
        rank_rngs = distributed.gather_json({"numpy_rng": self.rng.bit_generator.state,
                                            "action_rng": self.action_generator.get_state().tolist()}, self.model.device)
        if distributed.is_main():
            temporary = Path(str(path) + '.tmp')
            torch.save({"model_config": asdict(self.model.config), "model": self.model.state_dict(),
                    "ppo_config": asdict(self.config), "optimizer": self.optimizer.state_dict(),
                    "numpy_rng": self.rng.bit_generator.state,
                    "action_rng": self.action_generator.get_state(), "action_rng_backend": "cpu",
                    "real_interactions": self.real_interactions, "gradient_steps": self.gradient_steps,
                    "world_size": distributed.world_size(), "rank_rngs": rank_rngs,
                    "driver": driver}, temporary)
            temporary.replace(path)
        distributed.barrier()

    def restore(self, path):
        state = torch.load(path, map_location="cpu", weights_only=True)
        if state.get("action_rng_backend") != "cpu":
            raise ValueError("Legacy checkpoint RNG cannot be resumed across backends. "
                             "Use PFNPolicy.load for weights-only migration; start a new trainer.")
        if state.get('world_size', 1) != distributed.world_size():
            raise ValueError('Resume requires the same world size; use weights-only loading to change it')
        if (asdict(ModelConfig(**state["model_config"])) != asdict(self.model.config) or
                asdict(PPOConfig(**state["ppo_config"])) != asdict(self.config)):
            raise ValueError("Checkpoint model/training configuration mismatch.")
        self.model.load_state_dict(state["model"])
        self.optimizer.load_state_dict(state["optimizer"])
        for group in self.optimizer.param_groups:
            group['fused'] = False
            group['foreach'] = False
        for optimizer_state in self.optimizer.state.values():
            if 'step' in optimizer_state:
                step_device = 'cpu'
                optimizer_state['step'] = optimizer_state['step'].to(step_device)
        rng = state.get('rank_rngs', [state])[distributed.rank()]
        self.rng.bit_generator.state = rng["numpy_rng"]
        self.action_generator.set_state(torch.as_tensor(rng["action_rng"], dtype=torch.uint8, device='cpu'))
        self.real_interactions, self.gradient_steps = state["real_interactions"], state["gradient_steps"]
        return state["driver"]


def validation_score(model, prior, root, objective, rounds, count, gamma, episodes_per_task):
    returns = []
    for index in range(count):
        dynamics = "NONE" if objective == "static" else ("FC" if index % 2 == 0 else "CD")
        bundle = sample_task(prior, root, "validation", index, dynamics,
                             horizon=1 if objective == "static" else prior.horizon)
        pred = prediction_for(bundle, rounds, task_seed(root, "validation", index, 1)) if objective == "static" else None
        env = bundle.env(task_seed(root, "validation", index, 2), pred, objective == "static")
        generator = action_generator().manual_seed(task_seed(root, "validation", index, 3))
        # Multiple factual episodes per task evaluate the same context protocol as training.
        history = []
        for episode in range(1 if objective == "static" else episodes_per_task):
            steps, history = collect_episode(model, env, task_seed(root, "validation", index, 100 + episode),
                                             episode, history, generator, PPOConfig(gamma=gamma))
            returns.append(steps.episode_return(gamma))
    return float(np.mean(returns))


def deployment_validation(model, config):
    """Independent factual evaluation after adaptation, with weights frozen."""
    settings = config.get("sequential_meta", config["meta"])
    prior = TaskPrior(**config["prior"])
    root, gamma = config["seed"], config["ppo"]["gamma"]
    interactions = settings["validation_adaptation_interactions"]
    if interactions % prior.horizon:
        raise ValueError("Validation adaptation must contain full episodes.")
    count, replicates = settings["validation_tasks"], settings["validation_episodes"]
    results = {d: {"zero": [], "adapted": []} for d in ("FC", "CD")}
    for index in range(count):
        for dynamics in results:
            bundle = sample_task(prior, root, "validation", index, dynamics)
            generator = action_generator().manual_seed(
                episode_seed(root, "validation", index, 0, 0, 400))
            context = []
            episodes = interactions // prior.horizon
            for ep in range(episodes):
                noise = episode_seed(root, "validation", index, 0, ep, 600)
                _, context = collect_episode(model, bundle.env(noise), noise, ep, context,
                                             generator, PPOConfig(gamma=gamma))
            for label, prefix, ep in (("zero", (), 0), ("adapted", tuple(context), episodes)):
                for replicate in range(replicates):
                    noise = episode_seed(root, "validation", index, 0, replicate, 500)
                    # Each evaluation episode gets a private copy of the prefix.
                    steps, _ = collect_episode(model, bundle.env(noise), noise, ep, prefix,
                                               generator, PPOConfig(gamma=gamma), deterministic=True)
                    results[dynamics][label].append(steps.episode_return(gamma))
    result = {}
    for dynamics, values in results.items():
        result[f"validation_{dynamics}"] = float(np.mean(values["adapted"]))
        result[f"validation_zero_{dynamics}"] = float(np.mean(values["zero"]))
    result["validation_return"] = (result["validation_FC"] + result["validation_CD"]) / 2
    result["validation_interactions"] = 2 * count * (interactions + 2 * replicates * prior.horizon)
    return result


def train_meta(config, output, objective, device, resume=None):
    """On-the-fly latent tasks; never reuse a test task for pretraining."""
    device = resolve_device(device)
    output = Path(output)
    if distributed.is_main():
        output.mkdir(parents=True, exist_ok=True)
    distributed.barrier()
    prior = TaskPrior(**config["prior"])
    model_config = config.get("static_model", config["model"]) if objective == "static" else config["model"]
    ppo_config = config.get("static_ppo", config["ppo"]) if objective == "static" else config["ppo"]
    model = PFNPolicy(ModelConfig(**model_config)).to(device)
    trainer = PPOTrainer(model, PPOConfig(**ppo_config), config["seed"] + (objective == "static"))
    settings = config["meta"] if objective == "static" else config.get("sequential_meta", config["meta"])
    distributed.validate_training(settings, trainer.config)
    size, rank = distributed.world_size(), distributed.rank()
    local_tasks = settings["tasks_per_update"] // size
    start_update, best, cumulative_seconds, history_rows = 0, -float("inf"), 0.0, []
    binding = {"prior": asdict(prior), "meta": settings, "objective": objective,
               "root_seed": config["seed"], "estimation_rounds": config["estimation_rounds"]}
    if resume is not None:
        state = trainer.restore(resume)
        if state["binding"] != binding:
            raise ValueError("Meta-training task prior/seed/protocol mismatch.")
        start_update, best = state["next_update"], state["best_validation"]
        cumulative_seconds, history_rows = state["seconds"], state["history"]
        if distributed.is_main():
            # A resumed run keeps its previously selected model even in a new output folder.
            best_model = PFNPolicy(model.config).to(device)
            best_model.load_state_dict(state["best_model"])
            best_model.save(output / f"{objective}_best.pt", state["best_extra"])
    workers = config.get("infra", {}).get("env_workers", 8)
    workers = min(int(workers), local_tasks)
    with (ParallelEnvs(workers) if workers > 0 else nullcontext()) as environments:
        for update in range(start_update, settings["updates"]):
            phase_dir = os.environ.get('PFN_PROFILE_DIR') if objective == 'sequential' else None
            phase_limit = int(os.environ.get('PFN_PROFILE_UPDATES', '2')) if phase_dir else 0
            phase = {} if phase_dir and update < phase_limit else None
            with timed(device) as clock:
                with _profile_timer(phase, 'task_generation_s', device):
                    with _profile_timer(phase, 'task_spec_build_s', device):
                        episodes = 1 if objective == 'static' else settings['episodes_per_task']
                        specs = [(prior, config['seed'], update * settings['tasks_per_update'] + j,
                                  objective, config['estimation_rounds'], episodes)
                                 for j in range(rank * local_tasks, (rank + 1) * local_tasks)]
                    with _profile_timer(phase, 'task_parallel_prepare_s', device):
                        tasks = (environments.prepare_tasks(specs) if environments is not None
                                 else list(map(training_task, specs)))
                with _profile_timer(phase, 'rollout_total_s', device):
                    rollout_trace_dir = (os.environ.get('PFN_ROLLOUT_TRACE_DIR')
                                         if objective == 'sequential' else None)
                    trace = None
                    if (rollout_trace_dir and
                            update + 1 == int(os.environ.get('PFN_ROLLOUT_TRACE_UPDATE', '1')) and
                            rank == int(os.environ.get('PFN_ROLLOUT_TRACE_RANK', '0'))):
                        episode_index = int(os.environ.get('PFN_ROLLOUT_TRACE_EPISODE', '70'))
                        if not 0 <= episode_index < episodes:
                            raise ValueError(f'PFN_ROLLOUT_TRACE_EPISODE must be in [0,{episodes - 1}]')
                        trace = dict(dir=rollout_trace_dir, update=update + 1,
                                     rank=rank, episode=episode_index)
                    rollout = collect_tasks(model, tasks, episodes, trainer.action_generator,
                                            trainer.config, environments, profile=phase, trace=trace)
                with _profile_timer(phase, 'ppo_total_s', device):
                    metrics = trainer.update(rollout, profile=phase, update_index=update)
            if phase is not None:
                phase.update(update=update + 1, rank=rank, world_size=size,
                             local_tasks=local_tasks, local_transitions=len(rollout),
                             history_max=int(rollout.history_lengths[:len(rollout)].max()),
                             history_mean=float(rollout.history_lengths[:len(rollout)].mean()),
                             optimizer_steps=trainer.gradient_steps, update_total_s=clock['seconds'])
                Path(phase_dir).mkdir(parents=True, exist_ok=True)
                write_json(Path(phase_dir) / f'update{update + 1:04d}_rank{rank}.json', phase)
                if rank == 0:
                    print('PROFILE ' + json.dumps(phase, ensure_ascii=False), flush=True)
            if phase_dir and int(os.environ.get('PFN_PROFILE_STOP_AFTER', '0')) == update + 1:
                # Profiling-only early exit; all ranks must use the same setting.
                distributed.barrier()
                return None
            cumulative_seconds += distributed.max_value(clock["seconds"], device)
            row = {"update": update + 1, "real_interactions": trainer.real_interactions,
                   "training_seconds": cumulative_seconds, **metrics}
            if (update + 1) % settings["validate_every"] == 0 or update + 1 == settings["updates"]:
                driver = None
                if distributed.is_main():
                    with timed(device) as validation_clock:
                        if objective == "sequential" and settings.get("validation_protocol") == "deployment":
                            validation = deployment_validation(model, config)
                        else:
                            validation = {"validation_return": validation_score(
                                model, prior, config["seed"], objective, config["estimation_rounds"],
                                settings["validation_tasks"], trainer.config.gamma, settings["episodes_per_task"]),
                                "validation_interactions": settings["validation_tasks"] *
                                    (1 if objective == "static" else settings["episodes_per_task"] * prior.horizon)}
                    row.update(validation)
                    row["validation_seconds"] = validation_clock["seconds"]
                    score = validation["validation_return"]
                    extra = {"objective": objective, "validation_return": score,
                             "selected_update": update + 1, "pretrain_interactions_at_selection": trainer.real_interactions,
                             "training_seconds_at_selection": cumulative_seconds, "binding": binding,
                             "validation": validation}
                    if score > best:
                        best = score
                        model.save(output / f"{objective}_best.pt", extra)
                    selected = torch.load(output / f"{objective}_best.pt", map_location="cpu", weights_only=True)
                    history_rows.append(row)
                    driver = {"binding": binding, "next_update": update + 1, "best_validation": best,
                                        "seconds": cumulative_seconds, "history": history_rows,
                                        "best_model": selected["model"], "best_extra": selected["extra"]}
                    detail = (f", FC={validation['validation_FC']:.4f}, CD={validation['validation_CD']:.4f}"
                              if "validation_FC" in validation else "")
                    print(f"{objective}: update={update + 1}, interactions={trainer.real_interactions}, "
                          f"validation={score:.4f}{detail}", flush=True)
                trainer.checkpoint(output / f"{objective}_resume.pt", driver)
            elif distributed.is_main():
                history_rows.append(row)
            if distributed.is_main():
                pd.DataFrame(history_rows).to_csv(output / f"{objective}_training.csv", index=False)
    distributed.barrier()
    if not distributed.is_main():
        return None
    write_json(output / f"{objective}_training_cost.json",
               {"total_pretrain_interactions": trainer.real_interactions, "training_seconds": cumulative_seconds,
                "gradient_steps": trainer.gradient_steps, "objective": objective,
                "training_tasks": settings["updates"] * settings["tasks_per_update"],
                "validation_policy_interactions": sum(row.get("validation_interactions", 0) for row in history_rows),
                "validation_seconds": sum(row.get("validation_seconds", 0.0) for row in history_rows),
                "static_experiment_assignments": (settings["updates"] * settings["tasks_per_update"] *
                                                  config["estimation_rounds"] if objective == "static" else 0)})
    return PFNPolicy.load(output / f"{objective}_best.pt", device)[0]


def continue_tabular(checkpoint, bundle, additional_episodes, destination):
    """Resume at an episode boundary; environment noise seeds are reconstructed."""
    agent, next_episode, driver = TabularQ.load(checkpoint, bundle.public.fingerprint())
    for episode in range(next_episode, next_episode + additional_episodes):
        seed = episode_seed(driver["root_seed"], "test", driver["task_index"], driver["replicate"],
                            episode, driver["noise_stream"])
        env = bundle.env(seed)
        obs, _ = env.reset()
        while obs["tabular_state_key"][0] > 0:
            action = agent.act(obs, explore=True)
            next_obs, reward, done, _, _ = env.step(action)
            agent.observe(obs, action, reward, next_obs, done)
            obs = next_obs
    driver["next_episode"] = next_episode + additional_episodes
    agent.save(destination, bundle.public.fingerprint(), next_episode + additional_episodes, driver)
    return agent


def continue_scratch(checkpoint, bundle, config, additional_intervals, destination, device):
    device = resolve_device(device)
    model = PFNPolicy(ModelConfig(**config["model"])).to(device)
    trainer = PPOTrainer(model, PPOConfig(**config["ppo"]))
    driver = trainer.restore(checkpoint)
    if driver["binding"] != bundle.public.fingerprint():
        raise ValueError("Checkpoint does not belong to this graph/catalog/dynamics.")
    with open(Path(checkpoint).with_suffix(".context.pkl"), "rb") as f:
        context = pickle.load(f)
    next_episode = driver["next_episode"]
    for _ in range(additional_intervals):
        rollout = RolloutBuffer(config["evaluation"]["evaluate_every"], model.config.context_length)
        for _ in range(config["evaluation"]["evaluate_every"] // bundle.public.horizon):
            seed = episode_seed(driver["root_seed"], "test", driver["task_index"], driver["replicate"],
                                next_episode, driver["noise_stream"])
            env = bundle.env(seed)
            steps, context = collect_episode(model, env, seed, next_episode, context,
                                             trainer.action_generator, trainer.config, buffer=rollout)
            next_episode += 1
        trainer.update(rollout)
    driver["next_episode"] = next_episode
    trainer.checkpoint(destination, driver)
    with open(Path(destination).with_suffix(".context.pkl"), "wb") as f:
        pickle.dump(context, f)
    return model
